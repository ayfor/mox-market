# Mox Market local environment. Copy to .env: cp .env.example .env
# Local placeholders only. Never put a production URL or a real secret in any
# .env* file; production is Josh's channel (README, Database and migrations).

# Runtime queries (src/lib/prisma.ts reads only this one)
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/mox_market"
# Migrations and integration tests (prisma.config.ts reads this first)
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/mox_market"

# Generate: openssl rand -hex 32 (needed from S0.3)
CRON_SECRET="replace-me"
